{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "figjam-pro-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat: the diagram runners import nothing from node:, but zod
  // and the MCP SDK reach for a couple of shims. Cheap, and it keeps the
  // runners byte-identical to the ones the stdio server uses.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "FIGMA_ROOM", "class_name": "FigmaRoom" }]
  },
  "migrations": [
    {
      "tag": "v1",
      // new_sqlite_classes, not new_classes: SQLite-backed Durable Objects
      // are the ones included in the Workers FREE plan.
      "new_sqlite_classes": ["FigmaRoom"]
    }
  ],
  "kv_namespaces": [{ "binding": "PAIRS", "id": "cff04318a327476b876017298a9e2a16" }],
  // No "ratelimits" binding here, and it was tried. Measured against the
  // deployed Worker it blocked 14 calls made inside ONE request but let all
  // 14 through when they were 14 separate requests, because it counts per
  // edge machine. Pairing-code guesses arrive as separate requests, so the
  // counter now lives in the FigmaRoom durable object under the fixed name
  // "pair-guard" — see relay/src/room.ts.
  // WORKSPACE_KEY is a SECRET, not a var — `wrangler secret put
  // WORKSPACE_KEY`. It must never appear in this file, which is committed.
  //
  // No ALLOWED_EMAIL_DOMAINS by default: setting it turns on the
  // Cloudflare Access pairing flow, which is worth it for a locked-down
  // team and is too many steps for everyone else. The room id in the URL
  // is the credential in the default mode — see relay/src/index.ts.
  //
  // To require verified company email instead, set it here (and add the
  // Access application over the /login path — see docs/COWORK.md §4):
  //   "vars": { "ALLOWED_EMAIL_DOMAINS": "ikameglobal.com" },
  "observability": { "enabled": true }
}
